# The upstream release the macOS build is layered on, and the fork's revision on top of it.
# The branch ry-fixes must be based on tag UPSTREAM_TAG; the release tag is
# ${UPSTREAM_TAG}-ry.${FORK_REV}. Bump FORK_REV for every new release on the same base and
# reset it to 1 when moving to a new upstream tag.
UPSTREAM_TAG=2.3.0.2767
UPSTREAM_VERSION=2.3.0
FORK_REV=2
